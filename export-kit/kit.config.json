{
  "configVersion": 1,
  "id": "threejs",
  "series": "0.1",
  "shaderSource": "runtime",
  "engineSource": "kit",
  "shaderDialects": ["glsl"],
  "pageTemplate": true,
  "gatedTopLevelDirs": {
    "engine": "engine",
    "hostlib": "engine",
    "shaders": "shaders"
  },
  "subtrees": [
    { "from": "src", "to": "adapter/src" },
    { "from": "export-kit/engine", "to": "engine" }
  ],
  "overlays": [
    {
      "file": "adapter/src/engine-browser.js",
      "with": "export-kit/overlay/engine-browser.js",
      "anchor": "const EFFECTS_BASE = new URL('../vendor/noisemaker/effects/', import.meta.url)"
    }
  ],
  "licenses": [
    { "from": "LICENSE", "to": "LICENSES/noisemaker-for-threejs-LICENSE.txt" }
  ],
  "shaderLayout": {
    "root": "shaders"
  },
  "inject": {
    "type": "dsl-json-template",
    "target": "index.html"
  },
  "compat": {
    "mode": "all"
  },
  "engineBytesFrom": ["hostlib/", "engine/"],
  "hostLib": {
    "package": "three",
    "version": "0.171.0",
    "from": "node_modules/three/build",
    "files": ["three.module.min.js", "three.core.min.js"],
    "root": "hostlib/three",
    "entry": "hostlib/three/three.module.min.js"
  }
}
